# Required for vector storage (dense, hybrid, and hierarchical retrieval)
PINECONE_API_KEY=

# Required for Vertex AI Gemini generation, judging, and Gemini embeddings.
# GOOGLE_APPLICATION_CREDENTIALS must be an absolute path to a Google credential
# JSON file (for example, a service-account key with Vertex AI permissions).
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/google-credentials.json
# For cloud deployments, use the complete JSON document as a protected secret
# instead of committing a credential file.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Keyless Vercel deployment alternative: configure Vercel OIDC and Google
# Workload Identity Federation, then set all four values below. Vercel injects
# the short-lived OIDC token into each function request automatically.
GCP_PROJECT_NUMBER=
GCP_SERVICE_ACCOUNT_EMAIL=
GCP_WORKLOAD_IDENTITY_POOL_ID=vercel
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=vercel

# Set the key for each provider selected in config/pipeline.yaml
OPENAI_API_KEY=
COHERE_API_KEY=
VOYAGE_API_KEY=
PERPLEXITY_API_KEY=

# Required by LlamaParse ingestion. Values are Python-style lists so keys can
# rotate during long runs, for example: ['llx-key-1', 'llx-key-2']
LLAMAPARSE_API_KEYPOOL=[]

# Optional: only used by utilities that explicitly rotate Voyage keys. Normal
# Voyage embedding and reranking use VOYAGE_API_KEY above.
VOYAGE_API_KEYPOOL=[]

# Web feedback tool. For Vercel, use Supabase's transaction-pooler URL (6543).
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
TELCORAG_CHUNK_STORE=database
TELCORAG_CHUNKER=baseline
TELCORAG_BACKEND_URL=http://localhost:8000
TELCORAG_ADMIN_PASSWORD=change-me
TELCORAG_RETRIEVER=vector

# Optional pipeline overrides. Leave blank to use config/pipeline.yaml.
TELCORAG_EMBEDDER=
TELCORAG_QUERY_STRATEGY=
TELCORAG_RERANKER=

TELCORAG_RETRIEVAL_TOP_K=30
TELCORAG_RERANK_TOP_K=20
TELCORAG_REQUEST_TIMEOUT=180
